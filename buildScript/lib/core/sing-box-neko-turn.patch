@@ -0,0 +1,102 @@
+package turn
+
+import (
+	"context"
+	"net"
+	"testing"
+	"time"
+
+	pionturn "github.com/pion/turn/v4"
+	"github.com/sagernet/sing-box/common/dialer"
+	M "github.com/sagernet/sing/common/metadata"
+	N "github.com/sagernet/sing/common/network"
+)
+
+func TestLocalTURNUDPRelay(t *testing.T) {
+	turnListener, err := net.ListenPacket("udp4", "127.0.0.1:0")
+	if err != nil {
+		t.Fatal(err)
+	}
+	defer turnListener.Close()
+	turnAddr := turnListener.LocalAddr().(*net.UDPAddr)
+	turnTCPListener, err := net.Listen("tcp4", turnAddr.String())
+	if err != nil {
+		t.Fatal(err)
+	}
+	defer turnTCPListener.Close()
+
+	echoListener, err := net.ListenPacket("udp4", "127.0.0.1:0")
+	if err != nil {
+		t.Fatal(err)
+	}
+	defer echoListener.Close()
+	go func() {
+		buf := make([]byte, 2048)
+		for {
+			n, addr, readErr := echoListener.ReadFrom(buf)
+			if readErr != nil {
+				return
+			}
+			_, _ = echoListener.WriteTo(buf[:n], addr)
+		}
+	}()
+
+	server, err := pionturn.NewServer(pionturn.ServerConfig{
+		Realm: "pion.ly",
+		AuthHandler: func(username, realm string, _ net.Addr) ([]byte, bool) {
+			if username != "user" || realm != "pion.ly" {
+				return nil, false
+			}
+			return pionturn.GenerateAuthKey("user", "pion.ly", "pass"), true
+		},
+		PacketConnConfigs: []pionturn.PacketConnConfig{{
+			PacketConn: turnListener,
+			RelayAddressGenerator: &pionturn.RelayAddressGeneratorStatic{
+				RelayAddress: net.ParseIP("127.0.0.1"),
+				Address:      "127.0.0.1",
+			},
+		}},
+		ListenerConfigs: []pionturn.ListenerConfig{{
+			Listener: turnTCPListener,
+			RelayAddressGenerator: &pionturn.RelayAddressGeneratorStatic{
+				RelayAddress: net.ParseIP("127.0.0.1"),
+				Address:      "127.0.0.1",
+			},
+		}},
+	})
+	if err != nil {
+		t.Fatal(err)
+	}
+	defer server.Close()
+
+	targetAddr := echoListener.LocalAddr().(*net.UDPAddr)
+	o := &Outbound{
+		controlDialer:    &dialer.DefaultDialer{},
+		dataDialer:       &dialer.DefaultDialer{},
+		server:           M.ParseSocksaddrHostPort("127.0.0.1", uint16(turnAddr.Port)),
+		username:         "user",
+		password:         "pass",
+		network:          []string{N.NetworkUDP},
+		controlTransport: "tcp",
+	}
+
+	packetConn, err := o.ListenPacket(context.Background(), M.ParseSocksaddrHostPort("127.0.0.1", uint16(targetAddr.Port)))
+	if err != nil {
+		t.Fatal(err)
+	}
+	defer packetConn.Close()
+	if _, err = packetConn.WriteTo([]byte("turn-ok"), targetAddr); err != nil {
+		t.Fatal(err)
+	}
+	if err = packetConn.SetReadDeadline(time.Now().Add(3 * time.Second)); err != nil {
+		t.Fatal(err)
+	}
+	buf := make([]byte, 64)
+	n, _, err := packetConn.ReadFrom(buf)
+	if err != nil {
+		t.Fatal(err)
+	}
+	if string(buf[:n]) != "turn-ok" {
+		t.Fatalf("unexpected payload: %q", buf[:n])
+	}
+}
