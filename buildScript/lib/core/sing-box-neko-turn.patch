diff --git a/protocol/turn/outbound.go b/protocol/turn/outbound.go
new file mode 100644
index 000000000..54c80b219
--- /dev/null
+++ b/protocol/turn/outbound.go
@@ -0,0 +1,479 @@
+package turn
+
+import (
+	"context"
+	"errors"
+	"io"
+	"net"
+	"net/netip"
+	"os"
+	"strconv"
+	"sync"
+	"time"
+
+	"github.com/pion/transport/v4"
+	pionstdnet "github.com/pion/transport/v4/stdnet"
+	pionturn "github.com/pion/turn/v4"
+	"github.com/sagernet/sing-box/adapter"
+	"github.com/sagernet/sing-box/adapter/outbound"
+	"github.com/sagernet/sing-box/common/dialer"
+	singtls "github.com/sagernet/sing-box/common/tls"
+	C "github.com/sagernet/sing-box/constant"
+	"github.com/sagernet/sing-box/log"
+	"github.com/sagernet/sing-box/option"
+	"github.com/sagernet/sing/common"
+	E "github.com/sagernet/sing/common/exceptions"
+	"github.com/sagernet/sing/common/logger"
+	M "github.com/sagernet/sing/common/metadata"
+	N "github.com/sagernet/sing/common/network"
+	"github.com/sagernet/sing/service"
+)
+
+func RegisterOutbound(registry *outbound.Registry) {
+	outbound.Register[option.TURNOutboundOptions](registry, C.TypeTURN, NewOutbound)
+}
+
+var _ adapter.Outbound = (*Outbound)(nil)
+
+type Outbound struct {
+	outbound.Adapter
+	ctx              context.Context
+	logger           logger.ContextLogger
+	dnsRouter        adapter.DNSRouter
+	controlDialer    N.Dialer
+	dataDialer       N.Dialer
+	server           M.Socksaddr
+	username         string
+	password         string
+	network          []string
+	controlTransport string
+}
+
+func NewOutbound(ctx context.Context, router adapter.Router, logger log.ContextLogger, tag string, options option.TURNOutboundOptions) (adapter.Outbound, error) {
+	if options.Server == "" {
+		return nil, E.New("missing TURN server")
+	}
+	if options.ServerPort == 0 {
+		options.ServerPort = 3478
+	}
+	controlTransport := options.ControlTransport
+	if controlTransport == "" {
+		controlTransport = "udp"
+	}
+	if controlTransport != "udp" && controlTransport != "tcp" && controlTransport != "tls" {
+		return nil, E.New("unknown TURN control transport: ", controlTransport)
+	}
+
+	outboundDialer, err := dialer.New(ctx, options.DialerOptions, options.ServerIsDomain())
+	if err != nil {
+		return nil, err
+	}
+
+	dataDialer := outboundDialer
+	controlDialer := outboundDialer
+	if controlTransport == "tls" {
+		tlsOptions := common.PtrValueOrDefault(options.TLS)
+		tlsOptions.Enabled = true
+		controlDialer, err = singtls.NewDialerFromOptions(ctx, logger, outboundDialer, options.Server, tlsOptions)
+		if err != nil {
+			return nil, err
+		}
+	} else if options.TLS != nil && options.TLS.Enabled {
+		return nil, E.New("TURN TLS requires control_transport=tls")
+	}
+
+	return &Outbound{
+		Adapter:       outbound.NewAdapterWithDialerOptions(C.TypeTURN, tag, options.Network.Build(), options.DialerOptions),
+		ctx:           ctx,
+		logger:        logger,
+		dnsRouter:     service.FromContext[adapter.DNSRouter](ctx),
+		controlDialer: controlDialer,
+		dataDialer:    dataDialer,
+
+		server:           options.ServerOptions.Build(),
+		username:         options.Username,
+		password:         options.Password,
+		network:          options.Network.Build(),
+		controlTransport: controlTransport,
+	}, nil
+}
+
+func (o *Outbound) DialContext(ctx context.Context, network string, destination M.Socksaddr) (net.Conn, error) {
+	network = N.NetworkName(network)
+	switch network {
+	case N.NetworkTCP:
+		if !o.supports(N.NetworkTCP) {
+			return nil, os.ErrInvalid
+		}
+		peer, err := o.resolvePeer(ctx, destination, true)
+		if err != nil {
+			return nil, err
+		}
+		session, err := o.newSession(ctx)
+		if err != nil {
+			return nil, err
+		}
+		allocation, err := session.client.AllocateTCP()
+		if err != nil {
+			session.Close()
+			return nil, err
+		}
+		conn, err := allocation.DialTCP("tcp", nil, peer.(*net.TCPAddr))
+		if err != nil {
+			_ = allocation.Close()
+			session.Close()
+			return nil, err
+		}
+		session.allocation = allocation
+		return &managedConn{Conn: conn, session: session}, nil
+	case N.NetworkUDP:
+		if !o.supports(N.NetworkUDP) {
+			return nil, os.ErrInvalid
+		}
+		peer, err := o.resolvePeer(ctx, destination, false)
+		if err != nil {
+			return nil, err
+		}
+		packetConn, err := o.ListenPacket(ctx, destination)
+		if err != nil {
+			return nil, err
+		}
+		return &connectedPacketConn{PacketConn: packetConn, remote: peer}, nil
+	default:
+		return nil, E.Extend(N.ErrUnknownNetwork, network)
+	}
+}
+
+func (o *Outbound) ListenPacket(ctx context.Context, destination M.Socksaddr) (net.PacketConn, error) {
+	if !o.supports(N.NetworkUDP) {
+		return nil, os.ErrInvalid
+	}
+	session, err := o.newSession(ctx)
+	if err != nil {
+		return nil, err
+	}
+	allocation, err := session.client.Allocate()
+	if err != nil {
+		session.Close()
+		return nil, err
+	}
+	session.allocation = allocation
+	return &managedPacketConn{
+		PacketConn: allocation,
+		session:    session,
+		dnsRouter:  o.dnsRouter,
+	}, nil
+}
+
+func (o *Outbound) supports(network string) bool {
+	for _, item := range o.network {
+		if item == network {
+			return true
+		}
+	}
+	return false
+}
+
+func (o *Outbound) resolvePeer(ctx context.Context, destination M.Socksaddr, tcp bool) (net.Addr, error) {
+	if destination.IsIP() {
+		if tcp {
+			return destination.TCPAddr(), nil
+		}
+		return destination.UDPAddr(), nil
+	}
+	if o.dnsRouter == nil {
+		return nil, E.New("missing DNS router for TURN destination: ", destination.Fqdn)
+	}
+	addresses, err := o.dnsRouter.Lookup(ctx, destination.Fqdn, adapter.DNSQueryOptions{})
+	if err != nil {
+		return nil, err
+	}
+	if len(addresses) == 0 {
+		return nil, E.New("DNS lookup returned no address for TURN destination: ", destination.Fqdn)
+	}
+	if tcp {
+		return &net.TCPAddr{IP: addresses[0].AsSlice(), Port: int(destination.Port)}, nil
+	}
+	return &net.UDPAddr{IP: addresses[0].AsSlice(), Port: int(destination.Port)}, nil
+}
+
+func (o *Outbound) resolveServer(ctx context.Context) (netip.Addr, error) {
+	if o.server.IsIP() {
+		if o.server.Addr.Is6() {
+			return netip.Addr{}, E.New("TURN server IPv6 is not supported by the current TURN client")
+		}
+		return o.server.Addr, nil
+	}
+	if o.dnsRouter == nil {
+		return netip.Addr{}, E.New("missing DNS router for TURN server: ", o.server.Fqdn)
+	}
+	addresses, err := o.dnsRouter.Lookup(ctx, o.server.Fqdn, adapter.DNSQueryOptions{})
+	if err != nil {
+		return netip.Addr{}, err
+	}
+	if len(addresses) == 0 {
+		return netip.Addr{}, E.New("DNS lookup returned no address for TURN server: ", o.server.Fqdn)
+	}
+	for _, address := range addresses {
+		if address.Is4() {
+			return address, nil
+		}
+	}
+	return netip.Addr{}, E.New("TURN server has no IPv4 address: ", o.server.Fqdn)
+}
+
+func (o *Outbound) newSession(ctx context.Context) (*session, error) {
+	serverIP, err := o.resolveServer(ctx)
+	if err != nil {
+		return nil, err
+	}
+	server := M.SocksaddrFrom(serverIP, o.server.Port)
+
+	var control net.PacketConn
+	if o.controlTransport == "udp" {
+		control, err = o.controlDialer.ListenPacket(ctx, server)
+		if err != nil {
+			return nil, err
+		}
+	} else {
+		conn, dialErr := o.controlDialer.DialContext(ctx, N.NetworkTCP, server)
+		if dialErr != nil {
+			return nil, dialErr
+		}
+		control = pionturn.NewSTUNConn(conn)
+	}
+
+	stdNet, err := pionstdnet.NewNet()
+	if err != nil {
+		_ = control.Close()
+		return nil, err
+	}
+	pionNet := &pionNet{
+		Net:    stdNet,
+		ctx:    ctx,
+		dialer: o.dataDialer,
+	}
+	client, err := pionturn.NewClient(&pionturn.ClientConfig{
+		TURNServerAddr: net.JoinHostPort(serverIP.String(), strconv.Itoa(int(server.Port))),
+		Username:       o.username,
+		Password:       o.password,
+		Conn:           control,
+		Net:            pionNet,
+	})
+	if err != nil {
+		_ = control.Close()
+		return nil, err
+	}
+	if err = client.Listen(); err != nil {
+		client.Close()
+		_ = control.Close()
+		return nil, err
+	}
+	return &session{client: client, control: control}, nil
+}
+
+type session struct {
+	client     *pionturn.Client
+	control    net.PacketConn
+	allocation interface{ Close() error }
+	once       sync.Once
+}
+
+func (s *session) Close() error {
+	var err error
+	s.once.Do(func() {
+		if s.allocation != nil {
+			err = s.allocation.Close()
+		}
+		s.client.Close()
+		errControl := s.control.Close()
+		if err == nil {
+			err = errControl
+		}
+	})
+	return err
+}
+
+type managedConn struct {
+	net.Conn
+	session *session
+	once    sync.Once
+	err     error
+}
+
+func (c *managedConn) Close() error {
+	c.once.Do(func() {
+		c.err = c.Conn.Close()
+		if sessionErr := c.session.Close(); c.err == nil {
+			c.err = sessionErr
+		}
+	})
+	return c.err
+}
+
+type managedPacketConn struct {
+	net.PacketConn
+	session   *session
+	dnsRouter adapter.DNSRouter
+	once      sync.Once
+	err       error
+}
+
+func (c *managedPacketConn) ReadFrom(p []byte) (int, net.Addr, error) {
+	return c.PacketConn.ReadFrom(p)
+}
+
+func (c *managedPacketConn) WriteTo(p []byte, addr net.Addr) (int, error) {
+	resolved, err := resolveUDPAddr(context.Background(), c.dnsRouter, addr)
+	if err != nil {
+		return 0, err
+	}
+	return c.PacketConn.WriteTo(p, resolved)
+}
+
+func (c *managedPacketConn) Close() error {
+	c.once.Do(func() {
+		c.err = c.session.Close()
+	})
+	return c.err
+}
+
+type connectedPacketConn struct {
+	net.PacketConn
+	remote net.Addr
+}
+
+func (c *connectedPacketConn) Read(p []byte) (int, error) {
+	n, _, err := c.PacketConn.ReadFrom(p)
+	return n, err
+}
+
+func (c *connectedPacketConn) Write(p []byte) (int, error) {
+	return c.PacketConn.WriteTo(p, c.remote)
+}
+
+func (c *connectedPacketConn) RemoteAddr() net.Addr {
+	return c.remote
+}
+
+func (c *connectedPacketConn) LocalAddr() net.Addr {
+	return c.PacketConn.LocalAddr()
+}
+
+func (c *connectedPacketConn) SetDeadline(t time.Time) error {
+	return c.PacketConn.SetDeadline(t)
+}
+
+func (c *connectedPacketConn) SetReadDeadline(t time.Time) error {
+	return c.PacketConn.SetReadDeadline(t)
+}
+
+func (c *connectedPacketConn) SetWriteDeadline(t time.Time) error {
+	return c.PacketConn.SetWriteDeadline(t)
+}
+
+func resolveUDPAddr(ctx context.Context, dnsRouter adapter.DNSRouter, addr net.Addr) (*net.UDPAddr, error) {
+	switch value := addr.(type) {
+	case *net.UDPAddr:
+		return value, nil
+	case M.Socksaddr:
+		if value.IsIP() {
+			return value.UDPAddr(), nil
+		}
+		if dnsRouter == nil {
+			return nil, errors.New("missing DNS router for TURN UDP peer")
+		}
+		addresses, err := dnsRouter.Lookup(ctx, value.Fqdn, adapter.DNSQueryOptions{})
+		if err != nil {
+			return nil, err
+		}
+		if len(addresses) == 0 {
+			return nil, errors.New("DNS lookup returned no TURN UDP peer")
+		}
+		return &net.UDPAddr{IP: addresses[0].AsSlice(), Port: int(value.Port)}, nil
+	default:
+		return nil, E.New("unsupported TURN UDP peer address: ", addr)
+	}
+}
+
+type pionNet struct {
+	*pionstdnet.Net
+	ctx    context.Context
+	dialer N.Dialer
+}
+
+func (n *pionNet) DialTCP(network string, laddr, raddr *net.TCPAddr) (transport.TCPConn, error) {
+	ip, ok := netip.AddrFromSlice(raddr.IP)
+	if !ok {
+		return nil, E.New("invalid TURN TCP server address: ", raddr)
+	}
+	conn, err := n.dialer.DialContext(n.ctx, N.NetworkTCP, M.SocksaddrFrom(ip, uint16(raddr.Port)))
+	if err != nil {
+		return nil, err
+	}
+	return &tcpConn{Conn: conn}, nil
+}
+
+type tcpConn struct {
+	net.Conn
+}
+
+func (c *tcpConn) CloseRead() error {
+	if conn, ok := c.Conn.(interface{ CloseRead() error }); ok {
+		return conn.CloseRead()
+	}
+	return nil
+}
+
+func (c *tcpConn) CloseWrite() error {
+	if conn, ok := c.Conn.(interface{ CloseWrite() error }); ok {
+		return conn.CloseWrite()
+	}
+	return nil
+}
+
+func (c *tcpConn) ReadFrom(r io.Reader) (int64, error) {
+	return io.Copy(c.Conn, r)
+}
+
+func (c *tcpConn) SetLinger(sec int) error {
+	if conn, ok := c.Conn.(interface{ SetLinger(int) error }); ok {
+		return conn.SetLinger(sec)
+	}
+	return nil
+}
+
+func (c *tcpConn) SetKeepAlive(keepalive bool) error {
+	if conn, ok := c.Conn.(interface{ SetKeepAlive(bool) error }); ok {
+		return conn.SetKeepAlive(keepalive)
+	}
+	return nil
+}
+
+func (c *tcpConn) SetKeepAlivePeriod(period time.Duration) error {
+	if conn, ok := c.Conn.(interface{ SetKeepAlivePeriod(time.Duration) error }); ok {
+		return conn.SetKeepAlivePeriod(period)
+	}
+	return nil
+}
+
+func (c *tcpConn) SetNoDelay(noDelay bool) error {
+	if conn, ok := c.Conn.(interface{ SetNoDelay(bool) error }); ok {
+		return conn.SetNoDelay(noDelay)
+	}
+	return nil
+}
+
+func (c *tcpConn) SetWriteBuffer(bytes int) error {
+	if conn, ok := c.Conn.(interface{ SetWriteBuffer(int) error }); ok {
+		return conn.SetWriteBuffer(bytes)
+	}
+	return nil
+}
+
+func (c *tcpConn) SetReadBuffer(bytes int) error {
+	if conn, ok := c.Conn.(interface{ SetReadBuffer(int) error }); ok {
+		return conn.SetReadBuffer(bytes)
+	}
+	return nil
+}
