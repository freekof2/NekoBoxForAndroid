+)
+
+type SbV2rayServer struct {
+	ss *SbStatsService
+}
+
+func NewSbV2rayServer(options option.V2RayStatsServiceOptions) *SbV2rayServer {
+	return &SbV2rayServer{
+		ss: NewSbStatsService(options),
+	}
+}
+
